Back Projector parameters:=
   type := SPECTGPU
   Back projector Using SPECTGPU Parameters :=
      attenuation image filename := SPECTUB/attMapRec.hv
      collimator slope := 0.01
      collimator sigma 0(cm) := 0.07
      number of PSF sigmas := 3 ; default 2 (95% of the PSF)
      End Back Projector Using SPECTGPU Parameters :=
End:=
